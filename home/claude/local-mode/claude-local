#!/usr/bin/env bash
# claude-local — launch Claude Code in FULL-LOCAL mode, straight onto Ollama.
#
# No proxy: Ollama 0.30+ serves the native Anthropic /v1/messages endpoint, so
# Claude Code talks to it directly. Models per role come from roles.conf via
# sync-local.sh. Its own config dir (~/.claude-local) keeps the role-based
# subagents isolated from hybrid mode.
#
# Usage:
#   claude --local [claude args...]     (wrapper) or this script directly
#   claude-local --status               check Ollama reachability
set -euo pipefail

OLLAMA_HOST="http://localhost:11434"
ENVFILE="$HOME/.claude/local-mode/models.env"

# Server-side tuning we can only detect and warn about, not fix from here
# (both are settable in the Ollama app UI, which launchctl cannot see).
server_tuning_warnings() {
  # Context length: a Claude Code session needs a BIG window (the system
  # prompt alone is ~20K tokens); Ollama's default is far smaller and
  # silently truncates.
  local ctx="${OLLAMA_CONTEXT_LENGTH:-}"
  [[ -z "$ctx" ]] && command -v launchctl >/dev/null 2>&1 && ctx="$(launchctl getenv OLLAMA_CONTEXT_LENGTH 2>/dev/null || true)"
  if ! [[ "$ctx" =~ ^[0-9]+$ && "$ctx" -ge 65536 ]]; then
    echo "WARNING: Ollama server context length looks small or unset (${ctx:-default})." >&2
    echo "  Full-local mode needs >=64K or the session truncates its own instructions." >&2
    echo "  Fix: Ollama app -> Settings -> Context length, or restart the server with" >&2
    echo "    OLLAMA_CONTEXT_LENGTH=131072 ollama serve" >&2
    echo "  (If you already set it in the app UI, ignore this — it isn't detectable here.)" >&2
  fi

  # Keep-alive: the default 5m unloads the ~20GB orchestrator between turns —
  # every resume then pays a full model reload + prompt re-prefill.
  local ka="${OLLAMA_KEEP_ALIVE:-}"
  [[ -z "$ka" ]] && command -v launchctl >/dev/null 2>&1 && ka="$(launchctl getenv OLLAMA_KEEP_ALIVE 2>/dev/null || true)"
  if ! keep_alive_is_long "$ka"; then
    echo "WARNING: OLLAMA_KEEP_ALIVE looks short or unset (${ka:-default 5m})." >&2
    echo "  Idle >5min unloads the orchestrator model; the next turn pays a full" >&2
    echo "  reload + re-prefill. Set it to 1h (or -1 = never unload):" >&2
    echo "    launchctl setenv OLLAMA_KEEP_ALIVE 1h   (then restart the Ollama app)" >&2
    echo "  (If you already set it in the app UI, ignore this — it isn't detectable here.)" >&2
  fi
}

keep_alive_is_long() { # true if the value keeps models resident >= 30 min
  local v="$1"
  [[ "$v" =~ ^-[0-9] ]] && return 0  # any negative duration = never unload
  [[ "$v" =~ ^([0-9]+)h([0-9]+m?)?$ ]] && [[ "${BASH_REMATCH[1]}" -ge 1 ]] && return 0
  [[ "$v" =~ ^([0-9]+)m$ ]] && [[ "${BASH_REMATCH[1]}" -ge 30 ]] && return 0
  [[ "$v" =~ ^[0-9]+s?$ ]] && [[ "${v%s}" -ge 1800 ]] && return 0
  return 1
}

if [[ "${1:-}" == "--status" ]]; then
  if curl -sf "$OLLAMA_HOST/api/tags" >/dev/null 2>&1; then echo "Ollama: UP on $OLLAMA_HOST"; else echo "Ollama: down"; fi
  server_tuning_warnings
  exit 0
fi

# 1. Ollama must be installed and reachable.
if ! command -v ollama >/dev/null 2>&1; then
  echo "ERROR: full-local mode requires Ollama, which is not installed." >&2
  echo "  Install it from https://ollama.com/download (macOS: brew install ollama)," >&2
  echo "  then pull models: ./install.sh --with-models (or ollama pull per roles.conf)." >&2
  exit 1
fi
if ! curl -sf "$OLLAMA_HOST/api/tags" >/dev/null 2>&1; then
  echo "ERROR: Ollama is installed but not reachable on :11434." >&2
  echo "  Start it first: ollama serve (or launch the Ollama app)." >&2
  exit 1
fi

# 2. Server tuning sanity (context length, keep-alive) — warn only.
server_tuning_warnings

# 3. Ensure roles have been synced.
if [[ ! -f "$ENVFILE" ]]; then
  echo "No models.env yet — running sync-local.sh..."
  "$HOME/.claude/local-mode/sync-local.sh"
fi
# shellcheck disable=SC1090
source "$ENVFILE"

# 4. Launch Claude Code pointed straight at Ollama, in its own config dir.
echo "FULL-LOCAL mode — orchestrator: ${ANTHROPIC_MODEL} (via Ollama, no proxy)."
echo "Note: local models are weaker at long agentic chains; keep tasks tight."
exec env \
  CLAUDE_CONFIG_DIR="$HOME/.claude-local" \
  ANTHROPIC_BASE_URL="$OLLAMA_HOST" \
  ANTHROPIC_API_KEY="ollama-local" \
  ANTHROPIC_AUTH_TOKEN="ollama-local" \
  ANTHROPIC_MODEL="$ANTHROPIC_MODEL" \
  ANTHROPIC_SMALL_FAST_MODEL="$ANTHROPIC_SMALL_FAST_MODEL" \
  CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="1" \
  claude "$@"
