{
  "includeCoAuthoredBy": false,
  "statusLine": {
    "type": "command",
    "command": "sh \"$HOME/.claude/hooks/run-hook.sh\" \"$HOME/.claude/hooks/statusline.py\"",
    "padding": 0
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/run-hook.sh\" \"$HOME/.claude/hooks/dispatch-directive.py\"",
            "timeout": 10,
            "statusMessage": "Routing…"
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/run-hook.sh\" \"$HOME/.claude/hooks/keep-awake.py\" start",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/run-hook.sh\" \"$HOME/.claude/hooks/keep-awake.py\" stop",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/run-hook.sh\" \"$HOME/.claude/hooks/keep-awake.py\" stop",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/run-hook.sh\" \"$HOME/.claude/hooks/commit-guard.py\"",
            "timeout": 20,
            "statusMessage": "Commit guard…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/run-hook.sh\" \"$HOME/.claude/hooks/post-edit-lint.py\"",
            "timeout": 15,
            "statusMessage": "Syntax check…"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "php-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "effortLevel": "high",
  "skipWorkflowUsageWarning": true
}
